---
import type { ToolPage, NumericGroupsWidget } from '../data/tools';
export interface Props { tool: ToolPage }
const { tool } = Astro.props;
const w = tool.widget as NumericGroupsWidget; // this component only renders numeric-groups tools

// API base: same-origin in prod (/api/<group>). Overridable for local dev via PUBLIC_API_BASE.
const apiBase = import.meta.env.PUBLIC_API_BASE ?? '';
const endpoint = `${apiBase}/api/${tool.api.group}`;

const cfg = {
  endpoint,
  test: tool.api.test,
  groupsDefault: w.groupsDefault,
  groupsFixed: w.groupsFixed,
  groupLabel: w.groupLabel,
  sample: w.sample,
};
---

<section class="calc" aria-label="Calculator">
  <div id="calc-groups" class="calc-groups"></div>

  <div class="calc-actions">
    {!w.groupsFixed && (
      <>
        <button type="button" id="btn-add" class="btn btn-ghost">+ Add {w.groupLabel.toLowerCase()}</button>
        <button type="button" id="btn-remove" class="btn btn-ghost">– Remove</button>
      </>
    )}
    <button type="button" id="btn-sample" class="btn btn-ghost">Try sample data</button>
    <button type="button" id="btn-clear" class="btn btn-ghost">Clear</button>
    <button type="button" id="btn-calc" class="btn btn-primary">Calculate</button>
  </div>

  <div id="calc-error" class="calc-error" hidden></div>
  <div id="calc-result" class="calc-result" hidden></div>
</section>

<script define:vars={{ cfg }}>
  const groupsEl = document.getElementById('calc-groups');
  const resultEl = document.getElementById('calc-result');
  const errorEl = document.getElementById('calc-error');

  function makeGroup(index, value = '') {
    const wrap = document.createElement('div');
    wrap.className = 'calc-group';
    const label = document.createElement('label');
    label.textContent = `${cfg.groupLabel} ${index + 1}`;
    const ta = document.createElement('textarea');
    ta.className = 'calc-input';
    ta.rows = 4;
    ta.placeholder = 'Paste numbers — comma, space or newline separated';
    ta.value = value;
    wrap.append(label, ta);
    return wrap;
  }

  function renderGroups(n, values = []) {
    groupsEl.innerHTML = '';
    for (let i = 0; i < n; i++) {
      groupsEl.append(makeGroup(i, (values[i] || []).join(', ')));
    }
  }

  function parseNumbers(text) {
    return text
      .split(/[\s,;]+/)
      .map((s) => s.trim())
      .filter((s) => s.length)
      .map(Number);
  }

  function currentGroups() {
    return [...groupsEl.querySelectorAll('.calc-input')].map((ta) => parseNumbers(ta.value));
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
    resultEl.hidden = true;
  }

  function showResult(data) {
    errorEl.hidden = true;
    const rows = (data.rows || [])
      .map((r) => `<tr><th scope="row">${r[0]}</th><td>${r[1]}</td></tr>`)
      .join('');
    const sig = data.significant
      ? '<span class="badge badge-yes">Statistically significant</span>'
      : '<span class="badge badge-no">Not statistically significant</span>';
    resultEl.innerHTML = `
      <h2 class="result-head">${data.title} ${sig}</h2>
      <p class="result-verdict">${data.verdict}</p>
      <table class="result-table"><tbody>${rows}</tbody></table>
      ${data.apa ? `<div class="result-apa"><strong>APA format:</strong> <code>${data.apa}</code>
        <button type="button" class="btn btn-ghost btn-copy" data-copy="${data.apa.replace(/"/g, '&quot;')}">Copy</button></div>` : ''}
    `;
    resultEl.hidden = false;
    const copyBtn = resultEl.querySelector('.btn-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(copyBtn.getAttribute('data-copy'));
        copyBtn.textContent = 'Copied!';
        setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
      });
    }
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function calculate() {
    const groups = currentGroups();
    if (groups.some((g) => g.some((n) => Number.isNaN(n)))) {
      return showError('Some values are not numbers. Please check your input.');
    }
    if (groups.some((g) => g.length < 2)) {
      return showError('Each group needs at least 2 numbers.');
    }
    const btn = document.getElementById('btn-calc');
    btn.disabled = true;
    btn.textContent = 'Calculating…';
    try {
      const res = await fetch(cfg.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ test: cfg.test, groups }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `Server error (${res.status})`);
      showResult(data);
    } catch (e) {
      showError(e.message || 'Something went wrong.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Calculate';
    }
  }

  // ── wire up ──
  renderGroups(cfg.groupsDefault);
  document.getElementById('btn-calc').addEventListener('click', calculate);
  document.getElementById('btn-sample').addEventListener('click', () => {
    renderGroups(cfg.sample.length, cfg.sample);
  });
  document.getElementById('btn-clear').addEventListener('click', () => {
    renderGroups(groupsEl.children.length);
    resultEl.hidden = true;
    errorEl.hidden = true;
  });
  const addBtn = document.getElementById('btn-add');
  if (addBtn) {
    addBtn.addEventListener('click', () => {
      const vals = currentGroups();
      renderGroups(vals.length + 1, vals);
    });
    document.getElementById('btn-remove').addEventListener('click', () => {
      const vals = currentGroups();
      if (vals.length > 2) renderGroups(vals.length - 1, vals);
    });
  }
</script>
