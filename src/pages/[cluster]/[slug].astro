---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/Calculator.astro';
import LoanCalculator from '../../components/LoanCalculator.astro';
import TextAnalyzer from '../../components/TextAnalyzer.astro';
import { TOOLS, getTool, getCluster } from '../../data/tools';

export function getStaticPaths() {
  return TOOLS.map((t) => ({ params: { cluster: t.cluster, slug: t.slug } }));
}

const { cluster, slug } = Astro.params;
const tool = getTool(cluster!, slug!)!;
const c = getCluster(cluster!)!;
const path = `/${tool.cluster}/${tool.slug}/`;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.h1,
    description: tool.metaDescription,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: `${site}${path}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: c.name, item: `${site}/${c.slug}/` },
      { '@type': 'ListItem', position: 3, name: tool.h1 },
    ],
  },
];
---

<BaseLayout
  title={tool.title}
  description={tool.metaDescription}
  path={path}
  emoji={c.emoji}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb">
    <a href="/">Home</a> › <a href={`/${c.slug}/`}>{c.name}</a> › <span>{tool.h1}</span>
  </nav>

  <h1>{tool.h1}</h1>
  <p class="lede">{tool.intro}</p>

  {tool.widget.kind === 'loan' ? (
    <LoanCalculator tool={tool} />
  ) : tool.widget.kind === 'text' ? (
    <TextAnalyzer tool={tool} />
  ) : (
    <Calculator tool={tool} />
  )}

  <article class="explainer" set:html={tool.explainerHtml} />

  <section class="faq">
    <h2>Frequently asked questions</h2>
    {tool.faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  {tool.related.length > 0 && (
    <section class="related">
      <h2>Related {c.name.toLowerCase()} calculators</h2>
      <ul class="tool-grid">
        {tool.related.map((rs) => {
          const r = getTool(tool.cluster, rs);
          return r ? <li><a href={`/${r.cluster}/${r.slug}/`}>{r.h1}</a></li> : null;
        })}
      </ul>
    </section>
  )}
</BaseLayout>
